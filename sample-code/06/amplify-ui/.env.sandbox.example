# 第6章サンプル — ampx sandbox 用の環境変数テンプレート
# 実際の値を入れて `.env.sandbox` にリネーム（このファイルはコミット対象外）

# ---- Atlassian (Confluence + Jira) 連携 ----
# Lambda Handler で利用される接続先設定。Secret は別途 AWS CLI で投入する。
ATLASSIAN_BASE_URL=https://your-tenant.atlassian.net
CONFLUENCE_SPACE_KEY=YOURSPACE
JIRA_PROJECT_KEY=KAN
JIRA_ISSUE_TYPE=タスク

# ---- 推論プロファイルのコピー元 ARN（必須） ----
# アプリケーション推論プロファイル の `modelSource.copyFrom` に渡す ARN。
# Cross-Region Inference Profile の ARN を指定する想定。
MODEL_SOURCE_ARN=arn:aws:bedrock:us-east-1:<your-account-id>:inference-profile/us.anthropic.claude-sonnet-4-6

# ---- Runtime のモデル ID（任意） ----
# INFERENCE_PROFILE_ARN（SupportAiPlatform が払い出すもの）が優先される。
# プロファイル経由を強制したいなら未設定で OK。直接 FM を叩きたい場合に指定する。
# MODEL_ID=us.anthropic.claude-sonnet-4-6

# ---- Knowledge Base のベクトルストア種別 ----
# 既定: S3_VECTORS（コスト低・サンドボックス向き）
# OPENSEARCH_SERVERLESS に切り替える場合は一度 sandbox を delete してから再デプロイすること
KB_VECTOR_STORE=S3_VECTORS

# ---- Knowledge Basesのリランキング権限（任意） ----
# 有効化時だけKBサービスロールへbedrock:RerankとCohere Rerank 3.5の権限を追加する。
# bedrock:Rerankはリソースレベル権限に未対応のため、同アクションはResource "*"になる。
# KB_ENABLE_RERANKING=true

# ---- OpenSearch Serverless 公開設定 ----
# `KB_VECTOR_STORE=OPENSEARCH_SERVERLESS` 時のネットワークポリシー。
# 既定（false）はプライベート（VPC エンドポイントのみ）。サンドボックス検証で
# インターネット経由で動作確認する時だけ true にする（本番は必ず false）。
# OSS_ALLOW_PUBLIC=true
# プライベートにする場合の許可 VPC エンドポイント ID（カンマ区切り）
# OSS_SOURCE_VPCES=vpce-xxxxxxxxxxxxxxxxx,vpce-yyyyyyyyyyyyyyyyy

# ---- 環境名 ----
# dev / stg / prod。リソース名のサフィックスに使われる
ENV_NAME=dev
